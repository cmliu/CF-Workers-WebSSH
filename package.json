{
  "name": "cf-workers-webssh",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A dependency-free-at-runtime SSH terminal for Cloudflare Workers",
  "scripts": {
    "dev": "wrangler dev",
    "dev:web": "vite --config vite.config.ts",
    "build:web": "vite build --config vite.config.ts",
    "typecheck": "tsc -p tsconfig.worker.json --noEmit && tsc -p tsconfig.frontend.json --noEmit",
    "test": "vitest run",
    "test:edge": "vitest run --config vitest.edge.config.ts",
    "check": "npm run typecheck && npm run test && npm run test:edge && wrangler deploy --dry-run --outdir .wrangler/build",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.18.8",
    "@cloudflare/workers-types": "^5.20260727.1",
    "typescript": "^5.9.2",
    "vite": "^7.0.6",
    "vitest": "^4.1.10",
    "wrangler": "^4.114.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
